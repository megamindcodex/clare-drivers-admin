NODE_ENV=development
PORT=4000

# Origin the browser frontend is served from — must be an exact origin (no
# wildcard) for cors() to send Access-Control-Allow-Credentials: true.
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/clare-drivers-admin
REDIS_URL=redis://localhost:6379

SESSION_TTL_SECONDS=43200

JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN=5m

# Only used to bootstrap the first SuperAdmin — skipped once one already exists.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me

DATABASE_URL="mysql://user:password@localhost:3306/clare_drivers_admin"
